{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orasky.local/schemas/pending.schema.json",
  "title": "pending 卡片",
  "description": "章节产物中待办卡片数组（pending[] / issues[]）的元素规范。人读版见 docs/裁决台JSON规范.md 第 4、5 节",
  "type": "object",
  "required": [
    "id",
    "severity",
    "blocking"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$",
      "description": "卡片内只写后缀（如 p01）。装载层拼全 id：P|F-ch{章号}-{后缀}，全 id 受 ^(P|F)-ch\\d{3,4}-…$ 约束。段内禁下划线"
    },
    "kind": {
      "type": "string",
      "enum": [
        "pending",
        "fulfillment"
      ],
      "description": "由所在数组决定（pending[]/issues[]），装载时填；写卡人可不填"
    },
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "description": "全局章号。由章节产物的文件名派生，装载时填；写卡人可不填"
    },
    "volume": {
      "type": "integer",
      "description": "由 chapter 推导，不手填"
    },
    "bucket": {
      "type": "string",
      "description": "受控分类，显式填写。词表按书配置（backend/config.json 的 vocab.bucket），此处为缺省，校验器以 config 为准。见规范 1.3/4.5",
      "enum": [
        "实体与ID",
        "时间线",
        "数值算术",
        "设定源冲突",
        "正文一致性",
        "章节边界",
        "文本体例",
        "其他"
      ]
    },
    "severity": {
      "type": "string",
      "description": "受控词表，见规范 4.4",
      "enum": [
        "blocking",
        "critical",
        "high",
        "major",
        "medium",
        "low",
        "minor",
        "info"
      ]
    },
    "blocking": {
      "type": "boolean",
      "description": "真 bool。禁止用字符串「是/否」表达布尔——字符串「否」是真值，判断会反"
    },
    "title": {
      "type": "string",
      "maxLength": 240
    },
    "statement": {
      "type": "string",
      "maxLength": 800
    },
    "affected_entities": {
      "type": "array",
      "description": "涉及实体的库内 ID（如 wu_yuyan）。本卡牵涉哪些实体，供 归一ID/补建实体 等裁决的执行定位",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "description": "三段：authority / text / other，见规范 4.3",
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": "array",
          "description": "一条 = 一个卷 + 若干行；同卷多行合并进 lines[]。label 不进数据——显示名由装载层按「卷文件名:行」生成（见规范 4.3）",
          "items": {
            "type": "object",
            "required": [
              "volume",
              "lines"
            ],
            "additionalProperties": false,
            "properties": {
              "volume": {
                "type": "integer"
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "text": {
          "type": "array",
          "description": "file 统一正斜杠，禁反斜杠",
          "items": {
            "type": "object",
            "required": [
              "file"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^[^\\\\]*$",
                "description": "禁反斜杠"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "other": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "description": "给作者**选**的方案。倾向哪个写在候选的 recommended 上；有候选时 recommendation.text 不复述选项键（见规范 4.6）",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "fix_hint": {
      "type": "string",
      "maxLength": 800,
      "description": "**施工说明**：定了以后具体怎么改（可条件式「若选 A 则…」）。不表达倾向、不提问题、不请裁定。与 candidates（多选一）分工不同，不可合并"
    },
    "recommendation": {
      "description": "车道对这条问题的立场与把握：要不要动、为何取舍、保留意见。有候选时理由写成对比，不复述选项键（见规范 4.6）",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "text",
            "by"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 800,
              "description": "立场与理由，不是施工步骤（施工步骤属 fix_hint）"
            },
            "by": {
              "type": "string",
              "enum": [
                "lane",
                "author",
                "main"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "语义 = 判定确定性（这条主张多可靠），不是对候选的倾向——倾向只在 candidates[].recommended"
            },
            "note": {
              "type": "string",
              "maxLength": 800
            }
          }
        }
      ]
    },
    "why_pending": {
      "type": "string",
      "maxLength": 800,
      "description": "唯一的 why_* 键"
    },
    "impact": {
      "type": "string",
      "maxLength": 800
    },
    "severity_note": {
      "type": "string",
      "maxLength": 400
    },
    "extra": {
      "type": "object",
      "description": "认不出的字段的唯一去处。前端折叠，不进主区",
      "propertyNames": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "key",
        "title",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-C]$",
          "description": "大写单字母。标签写进 key 落盘，不从正文正则抠"
        },
        "title": {
          "type": "string",
          "maxLength": 40,
          "description": "短标签，一行不折行"
        },
        "body": {
          "type": "string",
          "maxLength": 2000,
          "description": "完整方案"
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "recommended": {
          "type": "boolean",
          "description": "倾向哪个选项——「选哪个」的唯一落点。全数组至多一个为 true（由校验器检查）"
        }
      }
    }
  }
}
