{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orasky.local/schemas/裁决.schema.json",
  "title": "裁决 JSON",
  "description": "裁决台：作者对卡片的裁定。人读版见 docs/裁决台JSON规范.md 第 6 节",
  "type": "object",
  "required": [
    "schema_version",
    "rulings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "顶层信封版本"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "本文件最后一次写入时间（ISO 8601，带时区）"
    },
    "source": {
      "type": "string",
      "description": "卡片池的文件路径"
    },
    "deprecated_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itemId"
      },
      "description": "已废弃、不再出现在裁决台上的条目 id（保留痕迹）"
    },
    "rulings": {
      "type": "object",
      "description": "条目 id（全 id）→ 裁决。id 本身受 itemId 正则约束。",
      "propertyNames": {
        "$ref": "#/$defs/itemId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/ruling"
      }
    }
  },
  "$defs": {
    "itemId": {
      "type": "string",
      "pattern": "^(P|F)-ch[0-9]{3,4}-[A-Za-z0-9]+(-[A-Za-z0-9]+)*$",
      "description": "P=待作者裁决；F=事实类。后缀分段用连字符，段内禁下划线。",
      "examples": [
        "P-ch576-p04",
        "P-ch683-p01-ch683",
        "F-ch437-ISS-437-01"
      ]
    },
    "verdict": {
      "type": "string",
      "description": "受控词表：这次动哪一侧的文件。禁自由文本。词表按书配置（backend/config.json 的 vocab.verdict），此处为缺省。见规范 1.3/6.3。",
      "enum": [
        "改正文",
        "改设定源",
        "改大纲",
        "改详纲",
        "改合同",
        "改索引",
        "归一ID",
        "补建实体",
        "判为无问题",
        "无法裁决",
        "交主流程"
      ]
    },
    "option": {
      "description": "只选键，不存方案全文。方案全文（candidates）在卡片侧。",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "A",
        "B",
        "C",
        null
      ]
    },
    "ruling": {
      "type": "object",
      "required": [
        "verdict",
        "option",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "oneOf": [
            {
              "$ref": "#/$defs/verdict"
            },
            {
              "type": "null",
              "description": "仅迁移期允许：尚未归类。必须同时 needs_reclassify=true。"
            }
          ]
        },
        "option": {
          "$ref": "#/$defs/option"
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "选填。作者补充意见，没写就省略或 null。禁放文件路径、禁放方案全文。建议 ≤200 字。"
        },
        "by": {
          "type": "string",
          "enum": [
            "author",
            "main",
            "migration"
          ],
          "description": "最后写入这条的角色。裁决台只能写 author。"
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "verdict 的写入时间（ISO 8601，带时区）"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "applied",
            "skipped",
            "overridden"
          ],
          "description": "执行状态。必须在同一份文件里，不另开基线文件。"
        },
        "applied_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "status=applied 时的落盘时间；否则 null。"
        },
        "override": {
          "description": "主流程依权威链改判作者原裁时的留痕。不得直接覆盖 verdict。",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "from",
                "to",
                "by",
                "at",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "$ref": "#/$defs/verdict"
                },
                "by": {
                  "type": "string",
                  "enum": [
                    "main",
                    "author"
                  ]
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          ]
        },
        "verdict_raw": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000,
          "description": "迁移期临时字段：迁移前的原始 verdict 原文，留痕用，归类完成后清空。"
        },
        "needs_reclassify": {
          "type": "boolean",
          "description": "迁移期临时字段：true = 尚未归类（此时 verdict 必为 null），主流程读到要补 verdict。"
        },
        "index_target": {
          "description": "verdict=改索引 时必填。",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "entity_id",
                "field"
              ],
              "additionalProperties": false,
              "properties": {
                "entity_id": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "type": "null"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "needs_reclassify": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "applied"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "applied_at"
            ],
            "properties": {
              "applied_at": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "enum": [
                  "判为无问题",
                  "无法裁决",
                  "交主流程"
                ]
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "option": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "改索引"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "index_target"
            ]
          }
        }
      ]
    }
  }
}
